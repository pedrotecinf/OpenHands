# syntax=docker/dockerfile:1.7
ARG BASE_IMAGE=ghcr.io/openhands/agent-canvas@sha256:91b7a217dcbefe8c10562523b043458ed1dfaf8ba770194b319fe754cee03f23

FROM --platform=$BUILDPLATFORM node:24-slim AS frontend
WORKDIR /build
COPY package.json package-lock.json ./
COPY vendor/ ./vendor/
RUN npm ci
COPY . .
ENV VITE_BASE_PATH=/canvas
RUN npm run build

FROM ${BASE_IMAGE}
USER root
ARG SDK_FORK_COMMIT=9f850bf8b3f7a785d5d833dd1e3af1c31f96028d
ARG CANVAS_FORK_COMMIT=unknown
RUN uv pip install --system --no-deps --force-reinstall \
    "git+https://github.com/pedrotecinf/software-agent-sdk@${SDK_FORK_COMMIT}#subdirectory=openhands-sdk" \
    "git+https://github.com/pedrotecinf/software-agent-sdk@${SDK_FORK_COMMIT}#subdirectory=openhands-tools" \
    "git+https://github.com/pedrotecinf/software-agent-sdk@${SDK_FORK_COMMIT}#subdirectory=openhands-workspace" \
    "git+https://github.com/pedrotecinf/software-agent-sdk@${SDK_FORK_COMMIT}#subdirectory=openhands-agent-server"
COPY --from=frontend /build/build/ /opt/agent-canvas/frontend/
COPY fork/patch_claude_resume.py /opt/agent-canvas/fork/patch_claude_resume.py
RUN python /opt/agent-canvas/fork/patch_claude_resume.py \
    /acp-node/lib/node_modules/@agentclientprotocol/claude-agent-acp/dist/acp-agent.js
COPY fork/openhands-agent-server-launcher /usr/local/bin/openhands-agent-server
RUN chmod 755 /usr/local/bin/openhands-agent-server
COPY fork/upgrade.json /opt/agent-canvas/fork/upgrade.json
COPY fork/smoke_canary.py /opt/agent-canvas/fork/smoke_canary.py
COPY fork/healthcheck.py /opt/agent-canvas/fork/healthcheck.py
ENV AGENT_CANVAS_BUILD_GIT_SHA=${CANVAS_FORK_COMMIT}
ENV OPENHANDS_BUILD_GIT_SHA=${SDK_FORK_COMMIT}
ENV OPENHANDS_BUILD_GIT_REF=upgrade/1.54.0-mcp-session-persistence
LABEL org.opencontainers.image.source="https://github.com/pedrotecinf/OpenHands"
LABEL org.opencontainers.image.revision="${CANVAS_FORK_COMMIT}"
LABEL io.pedrotecinf.sdk.revision="${SDK_FORK_COMMIT}"
HEALTHCHECK --interval=15s --timeout=12s --start-period=60s --retries=3 \
    CMD python /opt/agent-canvas/fork/healthcheck.py
USER openhands
